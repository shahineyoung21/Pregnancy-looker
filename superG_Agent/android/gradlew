#!/bin/sh
set -e
cd "$(dirname "$0")"
GRADLE_VERSION=8.7
GRADLE_HOME="\( HOME/.gradle/wrapper/dists/gradle- \){GRADLE_VERSION}-bin/gradle-${GRADLE_VERSION}"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "\( HOME/.gradle/wrapper/dists/gradle- \){GRADLE_VERSION}-bin"
  curl -fsSL -o /tmp/gradle.zip "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  unzip -q -o /tmp/gradle.zip -d "\( HOME/.gradle/wrapper/dists/gradle- \){GRADLE_VERSION}-bin"
  rm -f /tmp/gradle.zip
fi
exec "\( GRADLE_HOME/bin/gradle" " \)@"
